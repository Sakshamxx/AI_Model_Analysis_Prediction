# Supabase (paste from supabase.com dashboard > Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, never expose to frontend. Needed by FastAPI to verify
# user JWTs AND by Backend/retrain_export.py (privileged retrain export):
# SUPABASE_SERVICE_ROLE_KEY=
# Needed by FastAPI to verify user JWTs (Supabase dashboard > Project Settings > API > JWT Secret):
SUPABASE_JWT_SECRET=

# FastAPI backend
API_HOST=127.0.0.1
API_PORT=8000

# Local paths (relative to project root)
DATA_DIR=Data
BEST_REGRESSION_MODEL_PATH=Backend/best_regression_model.pkl
BEST_CLASSIFICATION_MODEL_PATH=Backend/best_classification_model.pkl
